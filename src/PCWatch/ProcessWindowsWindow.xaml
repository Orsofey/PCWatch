<Window x:Class="PCWatch.ProcessWindowsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="760" Height="470" MinWidth="600" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Title="PCWatch — окна приложения">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Окна приложения" Style="{StaticResource PageTitle}"/><TextBlock Text="{Binding SelectedProcess.Title}" Style="{StaticResource PageSubtitle}"/></StackPanel>
        <TextBlock Grid.Row="1" Margin="0,14,0,12" Style="{StaticResource Caption}" TextWrapping="Wrap" Text="Выберите окно, чтобы развернуть и вывести его на передний план. Если список пуст, приложение работает в фоне или не имеет видимых окон."/>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0"><DataGrid ItemsSource="{Binding SelectedProcess.Sample.Windows}" SelectedItem="{Binding SelectedWindow}" MouseDoubleClick="ActivateDoubleClick"><DataGrid.Columns><DataGridTextColumn Header="НАЗВАНИЕ ОКНА" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="70"/><DataGridTextColumn Header="СОСТОЯНИЕ" Binding="{Binding IsMinimized, Converter={StaticResource WindowStateConverter}}" Width="130"/></DataGrid.Columns></DataGrid></Border>
        <Grid Grid.Row="3" Margin="0,14,0,0"><Button Content="Открыть приложение" Style="{StaticResource BaseButton}" HorizontalAlignment="Left" Command="{Binding OpenApplicationCommand}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Закрыть" Style="{StaticResource BaseButton}" Margin="0,0,8,0" Click="CloseClick"/><Button Content="Показать окно" Style="{StaticResource PrimaryButton}" Click="ActivateClick"/></StackPanel></Grid>
    </Grid>
</Window>
