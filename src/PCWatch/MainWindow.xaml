<Window x:Class="PCWatch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:PCWatch.Controls"
        Width="1360" Height="860" MinWidth="1000" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BgBrush}" Icon="/PCWatch;component/Assets/PCWatch.ico"
        Title="PCWatch 2.0">
    <WindowChrome.WindowChrome><WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="29"/></Grid.RowDefinitions>

        <Border Grid.RowSpan="3" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="20,23,0,0" Height="42">
                    <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource AccentGradient}">
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0"><TextBlock Text="PCWatch" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="SYSTEM INTELLIGENCE" FontSize="8" Foreground="{StaticResource CyanBrush}" FontWeight="SemiBold"/></StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <TextBlock Text="МОНИТОРИНГ" Margin="25,0,0,8" Style="{StaticResource Caption}" FontSize="9" FontWeight="SemiBold"/>
                    <RadioButton GroupName="Nav" AutomationProperties.Name="Обзор" Style="{StaticResource NavButton}" IsChecked="True" Checked="NavChecked" Command="{Binding NavigateCommand}" CommandParameter="dashboard"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" VerticalAlignment="Center"/><TextBlock Text="Обзор" VerticalAlignment="Center"/></StackPanel></RadioButton>
                    <RadioButton GroupName="Nav" AutomationProperties.Name="Процессы" Style="{StaticResource NavButton}" Checked="NavChecked" Command="{Binding NavigateCommand}" CommandParameter="processes"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" VerticalAlignment="Center"/><TextBlock Text="Процессы" VerticalAlignment="Center"/></StackPanel></RadioButton>
                    <RadioButton GroupName="Nav" AutomationProperties.Name="Оптимизация" Style="{StaticResource NavButton}" Checked="NavChecked" Command="{Binding NavigateCommand}" CommandParameter="recommendations"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" VerticalAlignment="Center"/><TextBlock Text="Оптимизация" VerticalAlignment="Center"/></StackPanel></RadioButton>
                    <RadioButton GroupName="Nav" AutomationProperties.Name="Ресурсы" Style="{StaticResource NavButton}" Checked="NavChecked" Command="{Binding NavigateCommand}" CommandParameter="resources"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" VerticalAlignment="Center"/><TextBlock Text="Ресурсы" VerticalAlignment="Center"/></StackPanel></RadioButton>
                    <TextBlock Text="АНАЛИЗ" Margin="25,20,0,8" Style="{StaticResource Caption}" FontSize="9" FontWeight="SemiBold"/>
                    <RadioButton GroupName="Nav" AutomationProperties.Name="Диагностика" Style="{StaticResource NavButton}" Checked="NavChecked" Command="{Binding NavigateCommand}" CommandParameter="diagnostics"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9F5;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" VerticalAlignment="Center"/><TextBlock Text="Диагностика" VerticalAlignment="Center"/></StackPanel></RadioButton>
                    <RadioButton GroupName="Nav" AutomationProperties.Name="Отчёты" Style="{StaticResource NavButton}" Checked="NavChecked" Command="{Binding NavigateCommand}" CommandParameter="reports"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" VerticalAlignment="Center"/><TextBlock Text="Отчёты" VerticalAlignment="Center"/></StackPanel></RadioButton>
                    <RadioButton GroupName="Nav" AutomationProperties.Name="Настройки" Style="{StaticResource NavButton}" Checked="NavChecked" Command="{Binding NavigateCommand}" CommandParameter="settings"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="28" VerticalAlignment="Center"/><TextBlock Text="Настройки" VerticalAlignment="Center"/></StackPanel></RadioButton>
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="12,0,12,18">
                    <Border Background="#152235" BorderBrush="#294361" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,0,0,10">
                        <StackPanel><TextBlock Text="Emergency Mode" FontWeight="SemiBold" Foreground="{StaticResource CyanBrush}"/><TextBlock Text="Ctrl + Alt + F12" Style="{StaticResource Caption}" Margin="0,3,0,9"/><Button Content="Открыть" Style="{StaticResource BaseButton}" Padding="8,6" Command="{Binding EmergencyCommand}"/></StackPanel>
                    </Border>
                    <TextBlock Text="{Binding AdminModeText}" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                    <Button Content="Запустить от администратора" Style="{StaticResource BaseButton}" FontSize="10" Padding="5" Margin="0,7,0,0" Command="{Binding RunAsAdminCommand}" IsEnabled="{Binding IsAdmin, Converter={StaticResource InverseBooleanConverter}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="{StaticResource BgBrush}" MouseLeftButtonDown="TitleBarMouseDown">
            <TextBlock Text="PCWATCH  /  PERFORMANCE LAB" Margin="22,0,0,0" VerticalAlignment="Center" Style="{StaticResource Caption}" FontSize="10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="—" Width="45" Height="48" Style="{StaticResource BaseButton}" BorderThickness="0" Background="Transparent" Click="MinimizeClick"/>
                <Button Content="□" Width="45" Height="48" Style="{StaticResource BaseButton}" BorderThickness="0" Background="Transparent" Click="MaximizeClick"/>
                <Button Content="✕" Width="45" Height="48" Style="{StaticResource BaseButton}" BorderThickness="0" Background="Transparent" Foreground="{StaticResource RedBrush}" Click="CloseClick"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1" Grid.Row="1" Margin="26,10,26,14">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="2,0,0,20">
                <StackPanel><TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitle}"/><TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource PageSubtitle}"/></StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="11,7"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource GreenBrush}" Margin="0,0,7,0"/><TextBlock Text="LIVE" FontSize="10" Foreground="{StaticResource GreenBrush}" FontWeight="SemiBold"/><TextBlock Text="{Binding LastUpdate}" Margin="9,0,0,0" Style="{StaticResource Caption}"/></StackPanel></Border>
            </Grid>

            <Grid Grid.Row="1" Visibility="{Binding DashboardVisible}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16" Background="#121D2B">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid Width="108" Height="108"><c:HealthGauge Value="{Binding HealthScore}" Brush="{Binding HealthBrush}"/><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="{Binding HealthScore}" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="ИЗ 100" Style="{StaticResource Caption}" FontSize="9" HorizontalAlignment="Center"/></StackPanel></Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0"><TextBlock Text="{Binding HealthText}" FontSize="23" FontWeight="SemiBold" Foreground="{Binding HealthBrush}"/><TextBlock Text="{Binding HealthSummary}" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap" MaxWidth="700"/><TextBlock Text="Диагноз учитывает устойчивость отклонений, а не одиночные пики." Style="{StaticResource Caption}" Margin="0,9,0,0"/></StackPanel>
                                <Button Grid.Column="2" VerticalAlignment="Center" Content="Подробный отчёт  →" Style="{StaticResource PrimaryButton}" Command="{Binding NavigateCommand}" CommandParameter="reports"/>
                            </Grid>
                        </Border>
                        <UniformGrid Columns="3">
                            <c:MetricCard Margin="0,0,14,14" Title="ПРОЦЕССОР" Glyph="&#xE9D9;" Value="{Binding CpuValue}" Subtitle="{Binding CpuSubtitle}" Values="{Binding CpuHistory}" Accent="{StaticResource AccentBrush}" AreaFill="#226A8FFF"/>
                            <c:MetricCard Margin="0,0,14,14" Title="ПАМЯТЬ" Glyph="&#xE950;" Value="{Binding RamValue}" Subtitle="{Binding RamSubtitle}" Values="{Binding RamHistory}" Accent="{StaticResource VioletBrush}" AreaFill="#22AC8CFF"/>
                            <c:MetricCard Margin="0,0,0,14" Title="ДИСК" Glyph="&#xEDA2;" Value="{Binding DiskValue}" Subtitle="{Binding DiskSubtitle}" Values="{Binding DiskHistory}" Accent="{StaticResource GreenBrush}" AreaFill="#224DDBA0"/>
                            <c:MetricCard Margin="0,0,14,14" Title="ВИДЕОКАРТА" Glyph="&#xE7F4;" Value="{Binding GpuValue}" Subtitle="{Binding GpuSubtitle}" Values="{Binding GpuHistory}" Accent="{StaticResource AmberBrush}" AreaFill="#22FFB968"/>
                            <c:MetricCard Margin="0,0,14,14" Title="СЕТЬ" Glyph="&#xE774;" Value="{Binding NetValue}" Subtitle="{Binding NetSubtitle}" Values="{Binding NetHistory}" Maximum="{Binding NetworkMaximum}" Accent="{StaticResource CyanBrush}" AreaFill="#224CDED2"/>
                            <c:MetricCard Margin="0,0,0,14" Title="ФАЙЛ ПОДКАЧКИ" Glyph="&#xE8B7;" Value="{Binding PageValue}" Subtitle="{Binding PageFileSubtitle}" Values="{Binding PageFileHistory}" Accent="{StaticResource RedBrush}" AreaFill="#22FF7187"/>
                        </UniformGrid>
                        <Grid Margin="0,2,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Margin="0,0,14,0"><StackPanel><TextBlock Text="Динамика ресурсов" Style="{StaticResource SectionTitle}"/><TextBlock Text="Последние 120 измерений · ЦП / ОЗУ / диск / GPU" Style="{StaticResource Caption}" Margin="0,3,0,12"/><Grid Height="155"><c:Sparkline Values="{Binding CpuHistory}" Stroke="{StaticResource AccentBrush}" ShowGrid="True"/><c:Sparkline Values="{Binding RamHistory}" Stroke="{StaticResource VioletBrush}"/><c:Sparkline Values="{Binding DiskHistory}" Stroke="{StaticResource GreenBrush}"/><c:Sparkline Values="{Binding GpuHistory}" Stroke="{StaticResource AmberBrush}"/></Grid></StackPanel></Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Активные процессы" Style="{StaticResource SectionTitle}"/><TextBlock Text="По текущей загрузке ЦП" Style="{StaticResource Caption}" Margin="0,3,0,8"/><ItemsControl ItemsSource="{Binding TopProcesses}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}"/><TextBlock Text="{Binding Details}" Style="{StaticResource Caption}" FontSize="9"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding CpuText}" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid Grid.Row="1" Visibility="{Binding ProcessesVisible}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <WrapPanel Margin="0,0,0,12"><TextBlock Text="Поиск" VerticalAlignment="Center" Style="{StaticResource Caption}" Margin="0,0,8,0"/><TextBox Width="220" Style="{StaticResource Input}" AutomationProperties.Name="Поиск процесса по имени или PID" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Имя, название или PID"/><ComboBox Margin="9,0" SelectedValuePath="Content" SelectedValue="{Binding SortMode}" VerticalContentAlignment="Center" AutomationProperties.Name="Сортировка процессов"><ComboBoxItem Content="ЦП"/><ComboBoxItem Content="Память"/><ComboBoxItem Content="Диск"/><ComboBoxItem Content="Имя"/></ComboBox><Button x:Name="OpenApplicationButton" Content="Открыть" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Command="{Binding OpenApplicationCommand}"/><Button x:Name="FindWindowsButton" Content="Найти окна" Style="{StaticResource BaseButton}" Margin="0,0,8,0" Click="FindWindowsClick"/><Button Content="Расположение" Style="{StaticResource BaseButton}" Margin="0,0,8,0" Command="{Binding OpenLocationCommand}"/><Button Content="Свойства" Style="{StaticResource BaseButton}" Margin="0,0,8,0" Command="{Binding PropertiesCommand}"/><Button Content="Что это?" Style="{StaticResource BaseButton}" Margin="0,0,8,0" Command="{Binding WebSearchCommand}"/><Button Content="Завершить процесс" Style="{StaticResource DangerButton}" Command="{Binding TerminateProcessCommand}"/></WrapPanel>
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0"><DataGrid ItemsSource="{Binding ProcessesView}" SelectedItem="{Binding SelectedProcess}" MouseDoubleClick="ProcessDoubleClick" PreviewMouseRightButtonDown="ProcessRightClick">
                    <DataGrid.ContextMenu><ContextMenu><MenuItem Header="Открыть приложение" Command="{Binding OpenApplicationCommand}"/><MenuItem Header="Найти окна" Command="{Binding ShowWindowsCommand}"/><MenuItem Header="Открыть расположение" Command="{Binding OpenLocationCommand}"/><MenuItem Header="Свойства" Command="{Binding PropertiesCommand}"/><MenuItem Header="Найти процесс в интернете" Command="{Binding WebSearchCommand}"/><Separator/><MenuItem Header="Завершить процесс" Command="{Binding TerminateProcessCommand}"/></ContextMenu></DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="ПРИЛОЖЕНИЕ / ПРОЦЕСС" Width="2.2*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Image Source="{Binding Icon}" Width="23" Height="23" Margin="0,0,10,0"/><StackPanel><TextBlock Text="{Binding Title}"/><TextBlock Text="{Binding Details}" Style="{StaticResource Caption}" FontSize="9"/></StackPanel></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="65"/>
                        <DataGridTextColumn Header="ЦП" Binding="{Binding CpuText}" Width="90"/>
                        <DataGridTextColumn Header="ПАМЯТЬ" Binding="{Binding MemoryText}" Width="110"/>
                        <DataGridTextColumn Header="ДИСК" Binding="{Binding DiskText}" Width="110"/>
                        <DataGridTextColumn Header="GPU" Binding="{Binding GpuText}" Width="85"/>
                        <DataGridTextColumn Header="СТРАНИЦЫ/С" Binding="{Binding FaultsText}" Width="100"/>
                        <DataGridTextColumn Header="ОКНА" Binding="{Binding WindowText}" Width="90"/>
                        <DataGridTemplateColumn Header="СОСТОЯНИЕ" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding RespondingText}" Foreground="{Binding RespondingBrush}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid></Border>
                <TextBlock Grid.Row="2" Margin="3,10,0,0" Style="{StaticResource Caption}"><Run Text="Процессов: "/><Run Text="{Binding ProcessCount, Mode=OneWay}"/><Run Text="  ·  Delete — завершить выбранный  ·  системные процессы защищены"/></TextBlock>
            </Grid>

            <Grid Grid.Row="1" Visibility="{Binding RecommendationsVisible}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Background="#12231F"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Рекомендации без риска для активной работы" Style="{StaticResource SectionTitle}" Foreground="{StaticResource GreenBrush}"/><TextBlock Text="{Binding RecommendationSummary}" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"/><TextBlock Text="Не предлагаются активные окна, игры, виртуальные машины, разработка, синхронизация, драйверы, аудио и системные сервисы. Оценка памяти не гарантирует такое же освобождение после закрытия." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,9,0,0"/></StackPanel><Button Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Content="Сбросить скрытые" Style="{StaticResource BaseButton}" Command="{Binding ResetHiddenRecommendationsCommand}"/></Grid></Border>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12"><Button Content="Выбрать процесс" Style="{StaticResource BaseButton}" Margin="0,0,8,0" Command="{Binding SelectRecommendationCommand}"/><Button Content="Скрыть предложение" Style="{StaticResource BaseButton}" Margin="0,0,8,0" Command="{Binding HideRecommendationCommand}"/><Button Content="Завершить после подтверждения" Style="{StaticResource DangerButton}" Command="{Binding CloseRecommendationCommand}"/></StackPanel>
                <ListBox Grid.Row="2" ItemsSource="{Binding Recommendations}" SelectedItem="{Binding SelectedRecommendation}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="border" CornerRadius="12" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Image Source="{Binding Icon}" Width="32" Height="32" VerticalAlignment="Top" Margin="0,3,0,0"/><StackPanel Grid.Column="1"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Category}" Foreground="{Binding CategoryBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,0,12,0"/><TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"/></StackPanel><TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" Margin="0,2,0,8"/><TextBlock Text="{Binding Reason}" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"/><Border Background="{StaticResource CardAltBrush}" CornerRadius="7" Padding="10" Margin="0,10,0,0"><TextBlock Text="{Binding Impact}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></Border></StackPanel><StackPanel Grid.Column="2" Margin="18,0,0,0"><TextBlock Text="{Binding MemoryText}" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock Text="ОЗУ" Style="{StaticResource Caption}" HorizontalAlignment="Right"/><TextBlock Text="{Binding Score, StringFormat='Оценка {0}'}" Style="{StaticResource Caption}" Margin="0,10,0,0" HorizontalAlignment="Right"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </Grid></Grid>

            <Grid Grid.Row="1" Visibility="{Binding ResourcesVisible}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="Процессор" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding CpuName}" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"/><TextBlock Text="{Binding ClockStats}" Foreground="{StaticResource AccentBrush}" Margin="0,12,0,4"/><TextBlock Text="{Binding ProcessInfo}" Style="{StaticResource Caption}" TextWrapping="Wrap"/><ItemsControl ItemsSource="{Binding Latest.CoreUsage}" Margin="0,16,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource CardAltBrush}" CornerRadius="7" Margin="3" Padding="7"><TextBlock Text="{Binding StringFormat={}{0:0.0} %}" HorizontalAlignment="Center" FontSize="11"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                <UniformGrid Columns="2"><Border Style="{StaticResource Card}" Margin="0,0,14,14"><StackPanel><TextBlock Text="Оперативная память" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding RamValue}" FontSize="32" FontWeight="SemiBold" Margin="0,10,0,0"/><TextBlock Text="{Binding RamSubtitle}" Style="{StaticResource PageSubtitle}"/><Separator Margin="0,14"/><TextBlock Text="Commit" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Latest.CommitUsage, StringFormat={}{0:0.0} %}" FontSize="20"/><TextBlock Text="{Binding Latest.CommitUsedGB, StringFormat={}{0:0.0} ГБ используется}" Style="{StaticResource Caption}"/></StackPanel></Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="Файл подкачки и страницы" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding PageValue}" FontSize="32" FontWeight="SemiBold" Margin="0,10,0,0"/><TextBlock Text="{Binding PageFileSubtitle}" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"/><Separator Margin="0,14"/><TextBlock Text="Page Faults включают мягкие и жёсткие ошибки. Page Reads — операции чтения страниц с диска; точные hard faults доступны в ETW-анализе." Style="{StaticResource Caption}" TextWrapping="Wrap"/></StackPanel></Border></UniformGrid>
                <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="0"><StackPanel><TextBlock Text="Дисковые тома" Style="{StaticResource SectionTitle}" Margin="18,16,18,10"/><DataGrid ItemsSource="{Binding Volumes}" Height="185" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="ТОМ" Binding="{Binding Name}" Width="70"/><DataGridTextColumn Header="МЕТКА" Binding="{Binding Label}" Width="*"/><DataGridTextColumn Header="ФС" Binding="{Binding FileSystem}" Width="80"/><DataGridTextColumn Header="ОБЪЁМ, ГБ" Binding="{Binding TotalGB, StringFormat={}{0:0.0}}" Width="110"/><DataGridTextColumn Header="СВОБОДНО, ГБ" Binding="{Binding FreeGB, StringFormat={}{0:0.0}}" Width="120"/><DataGridTextColumn Header="СВОБОДНО" Binding="{Binding FreePercent, StringFormat={}{0:0.0} %}" Width="100"/></DataGrid.Columns></DataGrid></StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Обслуживание диска" Style="{StaticResource SectionTitle}"/><TextBlock Text="WhySoSlow проверяет фрагментацию HDD. PCWatch делает это только по запросу и никогда не запускает дефрагментацию SSD." Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="Анализ фрагментации HDD" Style="{StaticResource PrimaryButton}" Command="{Binding AnalyzeFragmentationCommand}"/><Button Content="Оптимизация дисков Windows" Style="{StaticResource BaseButton}" Margin="8,0,0,0" Command="{Binding OpenToolCommand}" CommandParameter="disks"/></StackPanel><Border Background="{StaticResource CardAltBrush}" CornerRadius="8" Margin="0,12,0,0" Padding="10"><ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding FragmentationResult}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></ScrollViewer></Border></StackPanel></Border>
            </StackPanel></ScrollViewer></Grid>

            <Grid Grid.Row="1" Visibility="{Binding DiagnosticsVisible}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="Расширенная диагностика ядра" Style="{StaticResource SectionTitle}"/><TextBlock Text="Отдельная ETW-сессия на 60 секунд измеряет DPC/ISR, связывает адреса с драйверами, оценивает задержки планировщика и считает hard page faults. Собственный драйвер не требуется." Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,14,0,9"><Button Content="{Binding AnalysisButtonText}" Style="{StaticResource PrimaryButton}" Command="{Binding RunAnalysisCommand}" IsEnabled="{Binding IsAnalyzing, Converter={StaticResource InverseBooleanConverter}}"/><Button Content="Режим администратора" Style="{StaticResource BaseButton}" Margin="8,0,0,0" Command="{Binding RunAsAdminCommand}"/></StackPanel><ProgressBar Value="{Binding AnalysisProgress, Mode=OneWay}" Maximum="100"/><TextBlock Text="{Binding AnalysisStatus}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,9,0,0"/></StackPanel></Border>
                <UniformGrid Columns="4" Margin="0,0,0,14"><Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="МАКС. DPC" Style="{StaticResource Caption}"/><TextBlock Text="{Binding MaxDpcText}" FontSize="22" Margin="0,5,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="МАКС. ISR" Style="{StaticResource Caption}"/><TextBlock Text="{Binding MaxIsrText}" FontSize="22" Margin="0,5,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="ПЛАНИРОВЩИК" Style="{StaticResource Caption}"/><TextBlock Text="{Binding DispatchText}" FontSize="22" Margin="0,5,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="HARD FAULTS" Style="{StaticResource Caption}"/><TextBlock Text="{Binding HardFaultText}" FontSize="22" Margin="0,5,0,0"/></StackPanel></Border></UniformGrid>
            </StackPanel><Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Visibility="{Binding AdvancedVisibility}"><DataGrid ItemsSource="{Binding Drivers}"><DataGrid.Columns><DataGridTextColumn Header="ДРАЙВЕР / ОБРАЗ" Binding="{Binding Driver}" Width="*"/><DataGridTextColumn Header="DPC" Binding="{Binding DpcCount}" Width="90"/><DataGridTextColumn Header="DPC ВСЕГО, МС" Binding="{Binding TotalDpcMs, StringFormat={}{0:0.0}}" Width="130"/><DataGridTextColumn Header="МАКС. DPC, МС" Binding="{Binding MaxDpcMs, StringFormat={}{0:0.0}}" Width="130"/><DataGridTextColumn Header="ISR" Binding="{Binding IsrCount}" Width="80"/><DataGridTextColumn Header="МАКС. ISR, МС" Binding="{Binding MaxIsrMs, StringFormat={}{0:0.0}}" Width="130"/></DataGrid.Columns></DataGrid></Border></Grid></Grid>

            <Grid Grid.Row="1" Visibility="{Binding ReportsVisible}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Margin="0,0,0,13"><Button Content="Экспорт HTML" Style="{StaticResource PrimaryButton}" Command="{Binding ExportHtmlCommand}"/><Button Content="Экспорт TXT" Style="{StaticResource BaseButton}" Margin="8,0" Command="{Binding ExportTextCommand}"/><Button Content="Копировать текст" Style="{StaticResource BaseButton}" Command="{Binding CopyReportCommand}"/></StackPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Issues}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel><TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Evidence}" Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"/><Border Background="{StaticResource CardAltBrush}" CornerRadius="8" Padding="11" Margin="0,12,0,0"><TextBlock Text="{Binding Recommendation}" Foreground="{StaticResource CyanBrush}" TextWrapping="Wrap"/></Border></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid></Grid>

            <Grid Grid.Row="1" Visibility="{Binding SettingsVisible}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                <UniformGrid Columns="2"><Border Style="{StaticResource Card}" Margin="0,0,14,14"><StackPanel><TextBlock Text="Мониторинг" Style="{StaticResource SectionTitle}"/><TextBlock Text="Интервал опроса, мс (250–10000)" Style="{StaticResource PageSubtitle}"/><TextBox Width="150" HorizontalAlignment="Left" Style="{StaticResource Input}" Text="{Binding Settings.SampleIntervalMs}" Margin="0,8,0,4"/><CheckBox Content="Сворачивать в системный трей" IsChecked="{Binding Settings.MinimizeToTray}"/><CheckBox Content="Запускать вместе с Windows" IsChecked="{Binding Settings.StartWithWindows}"/><CheckBox Content="Включить предупреждения" IsChecked="{Binding Settings.AlertsEnabled}"/><CheckBox Content="Вести CSV-журнал" IsChecked="{Binding Settings.CsvLogging}"/><Button Content="Сохранить настройки" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding SaveSettingsCommand}"/></StackPanel></Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="Системные инструменты" Style="{StaticResource SectionTitle}"/><TextBlock Text="Быстрый доступ без изменения настроек Windows." Style="{StaticResource PageSubtitle}"/><UniformGrid Columns="2" Margin="0,10,0,0"><Button Content="Диспетчер задач" Style="{StaticResource BaseButton}" Margin="3" Command="{Binding OpenToolCommand}" CommandParameter="taskmgr"/><Button Content="Просмотр событий" Style="{StaticResource BaseButton}" Margin="3" Command="{Binding OpenToolCommand}" CommandParameter="events"/><Button Content="Электропитание" Style="{StaticResource BaseButton}" Margin="3" Command="{Binding OpenToolCommand}" CommandParameter="power"/><Button Content="Установленные программы" Style="{StaticResource BaseButton}" Margin="3" Command="{Binding OpenToolCommand}" CommandParameter="programs"/></UniformGrid><TextBlock Text="Горячая клавиша Emergency Mode" Style="{StaticResource PageSubtitle}" Margin="0,14,0,0"/><TextBlock Text="Ctrl + Alt + F12" Foreground="{StaticResource CyanBrush}" FontSize="17" Margin="0,5,0,0"/><TextBlock Text="Никакие процессы не приостанавливаются и не завершаются автоматически." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border></UniformGrid>
                <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="Пороги предупреждений" Style="{StaticResource SectionTitle}"/><TextBlock Text="Предупреждение срабатывает только после удержания условия. Повтор ограничен интервалом 5 минут." Style="{StaticResource PageSubtitle}"/><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="170"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><TextBlock Text="МЕТРИКА" Style="{StaticResource Caption}"/><TextBlock Grid.Column="1" Text="ПОРОГ, %" Style="{StaticResource Caption}"/><TextBlock Grid.Column="2" Text="УДЕРЖАНИЕ, С" Style="{StaticResource Caption}"/></Grid>
                    <ItemsControl ItemsSource="{Binding Settings.Alerts}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="170"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Metric, Converter={StaticResource AlertMetricConverter}}" VerticalAlignment="Center"/><TextBox Grid.Column="1" Width="110" HorizontalAlignment="Left" Style="{StaticResource Input}" Text="{Binding Threshold}"/><TextBox Grid.Column="2" Width="110" HorizontalAlignment="Left" Style="{StaticResource Input}" Text="{Binding DurationSeconds}"/><CheckBox Grid.Column="3" IsChecked="{Binding Enabled}" VerticalAlignment="Center"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Приватность и ограничения" Style="{StaticResource SectionTitle}"/><TextBlock Text="Нет телеметрии и фоновой отправки данных. Отчёты сохраняются только по команде. Поиск процесса в интернете открывается только вручную. Температура зависит от системного датчика; низкоуровневые ETW-метрики требуют администратора." Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"/></StackPanel></Border>
            </StackPanel></ScrollViewer></Grid>
        </Grid>

        <Border Grid.Column="1" Grid.Row="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"><Grid Margin="17,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="6" Height="6" Fill="{StaticResource GreenBrush}" Margin="0,0,8,0"/><TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}" FontSize="10"/></StackPanel><TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Text="PCWatch 2.0.0  ·  .NET 4.8  ·  без драйверов" Style="{StaticResource Caption}" FontSize="9"/></Grid></Border>
    </Grid>
</Window>
