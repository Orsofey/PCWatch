<UserControl x:Class="PCWatch.Controls.MetricCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PCWatch.Controls"
             MinHeight="164">
    <Border Style="{StaticResource Card}" Padding="17">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid>
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=local:MetricCard}}" Style="{StaticResource Caption}" FontWeight="SemiBold"/>
                <Border HorizontalAlignment="Right" Width="31" Height="31" CornerRadius="9" Background="#202D41">
                    <TextBlock Text="{Binding Glyph, RelativeSource={RelativeSource AncestorType=local:MetricCard}}" Foreground="{Binding Accent, RelativeSource={RelativeSource AncestorType=local:MetricCard}}" FontFamily="Segoe MDL2 Assets" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
            <TextBlock Grid.Row="1" Margin="0,4,0,0" Text="{Binding Value, RelativeSource={RelativeSource AncestorType=local:MetricCard}}" FontSize="27" FontWeight="SemiBold"/>
            <TextBlock Grid.Row="2" Margin="0,1,0,6" Text="{Binding Subtitle, RelativeSource={RelativeSource AncestorType=local:MetricCard}}" Style="{StaticResource Caption}" FontSize="11"/>
            <local:Sparkline Grid.Row="3" MinHeight="43" Margin="-2,3,-2,-4"
                             Values="{Binding Values, RelativeSource={RelativeSource AncestorType=local:MetricCard}}"
                             Maximum="{Binding Maximum, RelativeSource={RelativeSource AncestorType=local:MetricCard}}"
                             Stroke="{Binding Accent, RelativeSource={RelativeSource AncestorType=local:MetricCard}}"
                             Fill="{Binding AreaFill, RelativeSource={RelativeSource AncestorType=local:MetricCard}}"/>
        </Grid>
    </Border>
</UserControl>
